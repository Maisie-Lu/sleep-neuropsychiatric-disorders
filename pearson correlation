#pearson correlation

cor_pearson <- cor.test(data$Var1, data$Var2, method = "pearson")
p <- ggplot(data, aes(x = Var1, y = Var2)) +
  # Scatter points
  geom_point(color = "#2E86AB", size = 2, alpha = 0.4) +
  # Linear fitted line with confidence interval
  geom_smooth(method = "lm", se = TRUE, color = "indianred", linewidth = 0.6) +
  # Add correlation coefficient and p-value
  stat_cor(aes(label = paste(..r.label.., ..p.label.., "N", nrow(data), sep = "~`,`~")),
           method = "pearson",
           label.x = mean(data$Var1),
           label.y = max(data$Var2) * 1,
           size = 4) +
  # Theme
  theme_minimal() +
  labs(x = "Var1",
       y = "Var2",
       subtitle = "All subjects") +
  theme(plot.title = element_text(size = 13, hjust = 0.5),
        plot.subtitle = element_text(size = 12, hjust = 0.5),
        axis.title = element_text(size = 11))
p
